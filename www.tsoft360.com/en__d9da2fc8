    (function () {
        const KEY_DISMISSED = 'tsoft_app_widget_dismissed';
        const KEY_FIRST_SEEN = 'tsoft_app_widget_first_seen';
        const KEY_SEEN_BEFORE = 'tsoft_app_widget_seen_before';
        const widget = document.getElementById('mobile-app-widget');
        const headerModal = document.getElementById('mobile-app-header-modal');

        if (headerModal) {
            const closeHeaderModal = () => {
                headerModal.classList.add('hidden');
                headerModal.classList.remove('flex');
            };
            const openHeaderModal = () => {
                headerModal.classList.remove('hidden');
                headerModal.classList.add('flex');
            };
            document.addEventListener('click', (e) => {
                if (e.target.closest('[data-mobile-app-modal-open]')) {
                    openHeaderModal();
                }
            });
            const modalCloseBtn = document.getElementById('mobile-app-header-modal-close');
            const modalBackdrop = document.getElementById('mobile-app-header-modal-backdrop');
            if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeHeaderModal);
            if (modalBackdrop) modalBackdrop.addEventListener('click', closeHeaderModal);
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !headerModal.classList.contains('hidden')) {
                    closeHeaderModal();
                }
            });
        }

        if (!widget) return;

        function isDismissed() {
            try {
                const dismissedUntil = localStorage.getItem(KEY_DISMISSED);
                if (dismissedUntil && Date.now() < parseInt(dismissedUntil, 10)) {
                    return true;
                }
            } catch (e) {}
            if (document.cookie.split(';').some((c) => c.trim().indexOf(KEY_DISMISSED + '=') === 0)) {
                return true;
            }
            return false;
        }

        if (isDismissed()) {
            widget.remove();
            return;
        }

        let firstSeen = null;
        try {
            firstSeen = localStorage.getItem(KEY_FIRST_SEEN);
            if (!firstSeen) {
                localStorage.setItem(KEY_FIRST_SEEN, Date.now().toString());
            }
        } catch (e) {}

        const installedBtn = document.getElementById('mobile-app-widget-installed');
        if (installedBtn) {
            let isSecondDayOrLater = false;
            try {
                const seenBefore = localStorage.getItem(KEY_SEEN_BEFORE);
                if (seenBefore === 'true') {
                    isSecondDayOrLater = true;
                } else if (firstSeen && (Date.now() - parseInt(firstSeen, 10)) >= 24 * 60 * 60 * 1000) {
                    isSecondDayOrLater = true;
                }
            } catch (e) {}

            if (isSecondDayOrLater) {
                installedBtn.classList.remove('hidden');
            }
        }

        let isShown = false;
        function showWidget() {
            if (isShown) return;
            isShown = true;
            widget.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
            widget.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
            window.removeEventListener('scroll', handleScroll);
        }

        function handleScroll() {
            if (window.scrollY > 150) {
                showWidget();
            }
        }

        function dismiss(days) {
            const expireTime = Date.now() + (days * 24 * 60 * 60 * 1000);
            try {
                localStorage.setItem(KEY_DISMISSED, expireTime.toString());
                localStorage.setItem(KEY_SEEN_BEFORE, 'true');
            } catch (e) {}
            try {
                const d = new Date();
                d.setTime(expireTime);
                document.cookie = KEY_DISMISSED + '=1;expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
            } catch (e) {}
            widget.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
            widget.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            setTimeout(() => {
                widget.remove();
            }, 300);
        }

        const closeBtn = document.getElementById('mobile-app-widget-close');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => dismiss(1));
        }

        if (installedBtn) {
            installedBtn.addEventListener('click', () => dismiss(30));
        }

        if (window.scrollY > 150) {
            showWidget();
        } else {
            window.addEventListener('scroll', handleScroll, { passive: true });
        }
    })();
